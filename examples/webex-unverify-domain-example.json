          "webex.com"
        ],
        "claimedDomains": [
          "cisco.com",
          "webex.com"
        ],
        "url": "https://identity.webex.com/organization/bf732c85-68ca-4867-94e4-937286ad2fd4/v1/actions/DomainVerification/Unverify/invoke"
      }
    }
  ]
}