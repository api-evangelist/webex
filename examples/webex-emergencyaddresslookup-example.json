{
  "operationId": "emergencyAddressLookup",
  "method": "POST",
  "path": "/telephony/pstn/locations/{locationId}/emergencyAddress/lookup",
  "summary": "Emergency Address Lookup to Verify if Address is Valid",
  "requestExamples": [
    {
      "contentType": "application/json",
      "example": {
        "address1": "3487 Chase Ave",
        "address2": "Apt 112",
        "city": "Miami Beach",
        "state": "FL",
        "postalCode": "33140",
        "country": "US"
      }
    }
  ],
  "responseExamples": [
    {
      "status": "200",
      "contentType": "application/json",
      "name": "validAddressExample",
      "example": {
        "addresses": [
          {
            "address1": "3487 Chase Ave",
            "address2": "Apt 112",
            "city": "Miami Beach",
            "state": "FL",
            "postalCode": "33140",
            "country": "US",
            "meta": {
              "houseNumber": "3487",
              "streetName": "Chase Ave",
              "country": "US",
              "state": "FL",
              "city": "Miami Beach",
              "zipCode": "33140",
              "latitude": "25.8131",
              "longitude": "-80.1300"
            }
          }
        ]
      }
    },
    {
      "status": "200",
      "contentType": "application/json",
      "name": "addressWithErrorsExample",
      "example": {
        "addresses": [
          {
            "address1": "3487 Chase Ave",
            "address2": "Apt 112",
            "city": "Miami Beach",
            "state": "FL",
            "postalCode": "33140",
            "country": "US",
            "meta": {
              "houseNumber": "3487",
              "streetName": "Chase Ave",
              "country": "US",
              "state": "FL",
              "city": "Miami Beach",
              "zipCode": "33140",
              "latitude": "25.8131",
              "longitude": "-80.1300"
            },
            "errors": [
              {
                "code": "PMP4004",
                "title": "INVALID_STREET_ADDRESS",
                "detail": "The street address provided is invalid."
              }
            ]
          }
        ]
      }
    }
  ]
}