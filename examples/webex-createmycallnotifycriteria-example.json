        "callsFrom": "ANY_PHONE_NUMBER",
        "anonymousCallersEnabled": true,
        "unavailableCallersEnabled": false,
        "notificationEnabled": true
      }
    }
  ],
  "responseExamples": [
    {
      "status": "200",
      "contentType": "application/json",
      "example": {
        "id": "Y2lzY29zcGFyazovL3VzL0NSSVRFUklBL1oxNzU0MzgzODQzNTA5NzY"
      }
    }
  ]
}