  "path": "/telephony/config/people/me/settings/callNotify/criteria",
  "summary": "Add a Call Notify Criteria",
  "requestExamples": [
    {
      "contentType": "application/json",
      "example": {
        "scheduleName": "Holiday V2",
        "scheduleType": "businessHours",
