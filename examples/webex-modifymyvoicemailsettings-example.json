{
  "operationId": "modifyMyVoicemailSettings",
  "method": "PUT",
  "path": "/telephony/config/people/me/settings/voicemail",
  "summary": "Configure Voicemail Settings for a Person",
  "requestExamples": [
    {
      "contentType": "application/json",
      "example": {
        "enabled": true,
        "notifications": {
          "enabled": true,
          "destination": "julie@example.com"
        },
        "sendAllCalls": {
          "enabled": true
        },
        "sendBusyCalls": {
          "enabled": false,
          "greeting": "DEFAULT"
        },
        "sendUnansweredCalls": {
          "enabled": false,
          "greeting": "CUSTOM",
          "numberOfRings": 3
        },
        "transferToNumber": {
          "enabled": false
        },
        "emailCopyOfMessage": {
          "enabled": false,
          "emailId": "julie@example.com"
        }
      }
    }
  ],
  "responseExamples": []
}