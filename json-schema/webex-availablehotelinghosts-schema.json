        "firstName": "John",
        "lastName": "Doe",
        "phoneNumber": "+14085551234",
        "extension": "1234",
        "allowedAssociationDuration": 24
      },
      {
        "hostId": "Y2lzY29zcGFyazovL3VzL1BFT1BMRS85ODc2NTQzMi0xMjM0LTU2NzgtOTBhYi1jZGVmMTIzNDU2Nzg",
        "firstName": "Jane",
        "lastName": "Smith",
