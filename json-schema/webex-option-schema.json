{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Option",
  "title": "Option",
  "type": "object",
  "properties": {
    "order": {
      "type": "string",
      "example": "1",
      "description": "The order of the option."
    },
    "value": {
      "type": "string",
      "example": "China",
      "description": "The value of the option."
    },
    "isCorrect": {
      "type": "boolean",
      "example": true,
      "description": "Whether or not the option is correct."
    }
  }
}