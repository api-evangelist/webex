{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ModifyVoicemailPasscode",
  "title": "ModifyVoicemailPasscode",
  "type": "object",
  "required": [
    "passcode"
  ],
  "properties": {
    "passcode": {
      "type": "string",
      "example": "1551234",
