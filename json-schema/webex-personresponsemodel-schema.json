{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PersonResponseModel",
  "title": "PersonResponseModel",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Profile View Template Id",
      "example": "638505f32332c8200dac025e"
    },
    "firstName": {
      "type": "string",
      "description": "firstName",
      "example": "John"
    },
    "lastName": {
      "type": "string",
      "description": "lastName",
      "example": "Doe"
    },
    "phone": {
      "type": "array",
      "description": "Phone Number",
      "example": [
        "+12342342345"
      ],
      "items": {
        "type": "string"
      }
    },
    "email": {
      "type": "array",
      "description": "Email",
      "example": [
        "johndoe@gmail.com"
      ],
      "items": {
        "type": "string"
      }
    },
    "temporaryId": {
      "type": "array",
      "description": "Temporary Id",
      "example": [
        "2342s-sdsd-342345"
      ],
      "items": {
        "type": "string"
      }
    },
    "customerId": {
      "type": "array",
      "description": "Customer Id",
      "example": [
        "234"
      ],
      "items": {
        "type": "string"
      }
    },
    "aliases": {
      "type": "array",
      "description": "Aliases",
      "example": [
        "234",
        "johndoe@gmail.com",
        "+12342342345"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Person Response Model"
}