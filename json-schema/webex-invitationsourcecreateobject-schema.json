{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/InvitationSourceCreateObject",
  "title": "InvitationSourceCreateObject",
  "type": "object",
  "required": [
    "sourceId",
    "sourceEmail"
  ],
  "properties": {
    "sourceId": {
      "type": "string",
      "example": "cisco",
      "description": "Source ID for the invitation."
    },
    "sourceEmail": {
      "type": "string",
      "example": "john001@example.com",
      "description": "Email for invitation source."
    }
  }
}