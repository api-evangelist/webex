{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BluetoothObjectDevice",
  "title": "BluetoothObjectDevice",
  "type": "object",
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "example": true,
      "description": "Enable/disable Bluetooth."
    },
    "mode": {
      "type": "string",
      "enum": [
        "PHONE",
        "HANDS_FREE",
        "BOTH"
      ],
      "description": "Select a Bluetooth mode."
    }
  }
}