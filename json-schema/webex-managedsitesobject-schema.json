{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ManagedSitesObject",
  "title": "ManagedSitesObject",
  "type": "object",
  "required": [
    "siteName",
    "role"
  ],
  "properties": {
    "siteName": {
      "type": "string",
      "example": "admintrainSiteName1.webex.com",
      "description": "Managed site name."
    },
    "role": {
      "type": "string",
      "example": "full_admin",
      "description": "Role in the managed site for the user."
    }
  }
}