{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GetPersonPlaceObject",
  "title": "GetPersonPlaceObject",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "example": "Y2lzY29zcGFyazovL3VzL1BFT1BMRS80NDVkMzMzMC1mNjE3LTExZWItOWQyZS01NzViODE3ZGE1NmE",
      "description": "ID of person or workspace."
    },
    "firstName": {
      "type": "string",
      "example": "Hakim",
      "description": "First name of person or workspace."
    },
    "lastName": {
      "type": "string",
      "example": "Smith",
      "description": "First name of person or workspace."
    },
    "phoneNumber": {
      "type": "string",
      "example": "+15555551234",
      "description": "Phone number of person or workspace."
    },
    "extension": {
      "type": "string",
      "example": "1234",
      "description": "Extension of person or workspace."
    },
    "weight": {
      "type": "string",
      "example": "50",
      "description": "Weight of person or workspace. Only applied when call policy is `WEIGHTED`."
    }
  }
}