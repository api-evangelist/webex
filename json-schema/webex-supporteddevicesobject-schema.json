  "$id": "#/components/schemas/supportedDevicesObject",
  "title": "supportedDevicesObject",
  "type": "object",
  "required": [
    "devices",
    "upgradeChannelList"
  ],
  "example": {
    "upgradeChannelList": [
      "STABLE",
      "STABLE_DELAY",
      "PREVIEW",
      "BETA",
      "TESTING"
    ],
    "devices": [
      {
