        "onboardingMethod": [
          "MAC_ADDRESS"
        ],
        "allowConfigureLayoutEnabled": false,
        "numberOfLinePorts": 14,
        "kemSupportEnabled": false,
        "kemLinesSupportEnabled": false,
        "upgradeChannelEnabled": false,
