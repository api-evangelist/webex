{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PriorityAlertGet",
  "title": "PriorityAlertGet",
  "type": "object",
  "required": [
    "enabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "example": true,
      "description": "`true` if the Priority Alert feature is enabled."
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/PriorityAlertCriteria"
      },
      "description": "A list of criteria specifying conditions when priority alert is in effect."
    }
  }
}