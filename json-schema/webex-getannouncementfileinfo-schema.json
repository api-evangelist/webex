{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GetAnnouncementFileInfo",
  "title": "GetAnnouncementFileInfo",
  "type": "object",
  "required": [
    "id",
    "fileName",
    "fileSize",
    "mediaFileType",
    "level",
    "isTextToSpeech"
  ],
  "properties": {
    "id": {
      "type": "string",
      "example": "Y2lzY29zcGFyazovL3VzL0FOTk9VTkNFTUVOVC9kODc5YWZlZC1jNTRhLTQyOTctOGY0Mi02ZmEyMDJjN2E1M2E",
      "description": "ID of the announcement."
    },
    "fileName": {
      "type": "string",
      "example": "Greeting-1.wav",
      "description": "Name of greeting file."
    },
    "fileSize": {
      "type": "string",
      "example": "33456",
      "description": "Size of greeting file in kilo-bytes."
    },
    "mediaFileType": {
      "$ref": "#/components/schemas/mediaType",
      "description": "Media file type of the announcement."
    },
    "level": {
      "$ref": "#/components/schemas/level",
      "description": "Level where the announcement is created."
    },
    "isTextToSpeech": {
      "type": "boolean",
      "description": "Indicates whether the announcement is a text-to-speech file."
    }
  }
}