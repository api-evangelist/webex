{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/NumberListGetObject",
  "title": "NumberListGetObject",
  "type": "object",
  "required": [
    "phoneNumbers"
  ],
  "properties": {
    "phoneNumbers": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/NumberObject"
