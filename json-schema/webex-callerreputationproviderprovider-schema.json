{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/CallerReputationProviderProvider",
  "title": "CallerReputationProviderProvider",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the provider.",
      "example": "provider-123"
    },
    "enabled": {
      "type": "boolean",
      "description": "Indicates if the provider is enabled.",
      "example": true
    },
    "name": {
      "type": "string",
      "description": "Name of the provider.",
      "example": "Acme Reputation Provider"
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/CallerReputationProviderRegion"
      },
      "description": "List of regions for the provider."
    }
  },
  "example": {
    "id": "provider-123",
    "enabled": true,
    "name": "Acme Reputation Provider",
    "regions": [
      {
        "id": "region-1",
        "name": "US East",
        "type": "primary",
        "visible": true,
        "environmentType": "production"
      }
    ]
  }
}