{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BulkExportDTOMultimediaProfileExportDTO",
  "title": "BulkExportDTOMultimediaProfileExportDTO",
  "type": "object",
  "properties": {
    "totalResources": {
      "type": "integer",
      "description": "Total number of items",
      "format": "int32",
      "example": 100
    },
    "pageNumber": {
      "type": "integer",
      "description": "Current page number",
      "format": "int32",
      "example": 0
    },
    "pageSize": {
      "type": "integer",
      "description": "Page size for current data set",
      "format": "int32",
      "example": 50
    },
    "rel": {
      "type": "string",
      "description": "Indicates whether more pages exist. When 'next' there are more pages available, otherwise 'last'.",
      "example": "last"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/MultimediaProfileExportDTO"
      }
    }
  }
}