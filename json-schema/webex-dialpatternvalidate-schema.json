{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DialPatternValidate",
  "title": "DialPatternValidate",
  "type": "object",
  "properties": {
    "dialPattern": {
      "type": "string",
      "example": "+4555",
      "description": "Input dial pattern that is being validated."
    },
    "patternStatus": {
      "$ref": "#/components/schemas/DialPatternStatus",
      "description": "Validation status."
    },
    "message": {
      "type": "string",
      "example": "invalid format for premises dial pattern +4555",
      "description": "Failure details."
    }
  }
}