{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UserBargeInGet",
  "title": "UserBargeInGet",
  "type": "object",
  "required": [
    "enabled",
    "toneEnabled"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "example": true,
      "description": "`true` if the BargeIn feature is enabled."
    },
    "toneEnabled": {
      "type": "boolean",
      "description": "When `true`, a tone is played when someone barges into a call."
    }
  }
}