{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/RouteListNumberPatch",
  "title": "RouteListNumberPatch",
  "type": "object",
  "required": [
    "number",
    "action"
  ],
  "properties": {
    "number": {
      "type": "string",
      "example": "+2147891122",
      "description": "Number to be deleted/added."
    },
    "action": {
      "$ref": "#/components/schemas/ActionOnRouteList",
      "description": "Possible value, `ADD` or `DELETE`."
    }
  }
}