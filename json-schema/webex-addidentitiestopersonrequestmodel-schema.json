  "title": "AddIdentitiesToPersonRequestModel",
  "type": "object",
  "properties": {
    "phone": {
      "type": "array",
      "description": "Phone Number",
      "example": [
        "+12342342345"
      ],
      "items": {
        "type": "string"
      }
    },
    "email": {
      "type": "array",
      "description": "Email",
      "example": [
        "johndoe@gmail.com"
      ],
      "items": {
        "type": "string"
      }
    },
    "temporaryId": {
      "type": "array",
      "description": "Temporary Id",
      "example": [
        "2342s-sdsd-342345"
      ],
      "items": {
        "type": "string"
      }
    },
    "customerId": {
      "type": "array",
      "description": "Customer Id",
      "example": [
        "234"
      ],
      "items": {
        "type": "string"
      }
    }
  },
  "description": "Add Identities to Person"
}