{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GetLocationAccessCodeObject",
  "title": "GetLocationAccessCodeObject",
  "type": "object",
  "properties": {
    "accessCodes": {
      "type": "object",
      "required": [
        "code",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "example": "123",
          "description": "Access code number."
        },
        "description": {
          "type": "string",
          "example": "Main Access Code",
          "description": "Access code description."
        }
      },
      "description": "Access code details"
    }
  }
}