{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ProfileViewAttributeRequestModel",
  "title": "ProfileViewAttributeRequestModel",
  "required": [
    "aggregationMode",
    "displayName",
    "event",
    "limit",
    "lookBackDurationType",
    "lookBackPeriod",
    "metaData",
    "metaDataType",
    "verbose",
    "version"
  ],
  "type": "object",
  "properties": {
    "displayName": {
      "type": "string",
      "description": "displayName",
      "example": "Name"
    },
    "version": {
      "type": "string",
      "description": "version",
      "example": "1.1"
    },
    "event": {
      "type": "string",
      "description": "event",
      "example": "task:new"
    },
    "metaDataType": {
      "type": "string",
      "description": "metaDataType",
      "example": "string"
    },
    "metaData": {
      "type": "string",
      "description": "metaData",
      "example": "origin"
    },
    "limit": {
      "minimum": 0,
      "type": "integer",
      "description": "limit",
      "format": "int32",
      "example": 30
    },
    "lookBackDurationType": {
      "type": "string",
      "description": "lookBackDurationType",
      "example": "days"
    },
    "lookBackPeriod": {
      "minimum": 1,
      "type": "integer",
      "description": "lookBackPeriod",
      "format": "int32",
      "example": 10
    },
    "aggregationMode": {
      "type": "string",
      "description": "aggregationMode",
      "example": "Count"
    },
    "verbose": {
      "type": "boolean",
      "description": "verbose",
      "example": true
    },
    "widgetAttributes": {
      "$ref": "#/components/schemas/WidgetAttributesRequestModel"
    },
    "rules": {
      "$ref": "#/components/schemas/Rules"
    }
  },
  "description": "Create or Update Attribute of a ProfileViewTemplate"
}