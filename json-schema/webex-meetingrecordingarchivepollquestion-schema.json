{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/MeetingRecordingArchivePollQuestion",
  "title": "MeetingRecordingArchivePollQuestion",
  "type": "object",
  "properties": {
    "voteUsers": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/MeetingRecordingArchiveUser"
      },
      "description": "The voters among users."
    },
    "question": {
      "type": "object",
      "properties": {
        "choiceCount": {
          "type": "number",
          "example": 3,
          "description": "The number of choices in the questions."
        },
        "type": {
          "type": "string",
          "example": "single",
          "description": "The type of the question."
        },
        "text": {
          "type": "string",
          "example": "Do you like this API?",
          "description": "The text of the question."
        }
      },
      "description": "The poll's question."
    },
    "answerSummary": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/MeetingRecordingArchivePollAnswerSummary"
      },
      "description": "The answer summary of the archive poll."
    },
    "respondents": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/MeetingRecordingArchivePollRespondent"
      },
      "description": "The question's respondents."
    }
  }
}