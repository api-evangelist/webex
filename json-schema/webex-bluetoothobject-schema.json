{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BluetoothObject",
  "title": "BluetoothObject",
  "type": "object",
  "required": [
    "enabled",
    "mode"
  ],
  "properties": {
    "enabled": {
      "type": "boolean",
      "example": true,
      "description": "Enable/disable Bluetooth."
    },
    "mode": {
      "type": "string",
      "enum": [
        "PHONE"
      ],
      "description": "Select a Bluetooth mode."
    },
    "PHONE": {
      "type": "string"
    },
    "HANDS_FREE": {
      "type": "string"
    },
    "BOTH": {
      "type": "string"
    }
  }
}