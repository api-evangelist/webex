{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/UserOutgoingPermissionDigitPatternGetListObject",
  "title": "UserOutgoingPermissionDigitPatternGetListObject",
  "type": "object",
  "required": [
    "useCustomDigitPatterns",
    "digitPatterns"
  ],
  "properties": {
    "useCustomDigitPatterns": {
      "type": "boolean",
      "description": "When `true`, use custom settings for the digit patterns category of outgoing call permissions."
    },
    "digitPatterns": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/UserDigitPatternObject"
      },
      "description": "List of digit patterns."
    }
  }
}