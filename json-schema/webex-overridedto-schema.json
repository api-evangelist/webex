{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OverrideDTO",
  "title": "OverrideDTO",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 80,
      "minLength": 0,
      "pattern": "^[a-zA-Z0-9_-]+(\\s?[a-zA-Z0-9_-]+)*$"
    },
    "startDateTime": {
      "type": "string"
    },
    "endDateTime": {
      "type": "string"
    },
    "workingHours": {
      "type": "boolean"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "DontRepeat",
        "Daily",
        "Weekly",
        "Monthly",
        "Yearly"
      ]
    },
    "recurrence": {
      "$ref": "#/components/schemas/RecurrenceDTO"
    }
  },
  "required": [
    "name",
    "workingHours"
  ]
}