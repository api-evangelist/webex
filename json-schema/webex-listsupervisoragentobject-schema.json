{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ListSupervisorAgentObject",
  "title": "ListSupervisorAgentObject",
  "type": "object",
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "example": "Y2lzY29zcGFyazovL3VzL1BFT1BMRS85NTA4OTc4ZC05YmFkLTRmYWEtYTljNC0wOWQ4NWQ4ZmRjZTY",
      "description": "ID of person, workspace or virtual line."
    },
    "lastName": {
      "type": "string",
      "example": "user",
      "description": "Last name of the agent."
    },
    "firstName": {
      "type": "string",
      "example": "test",
      "description": "First name of the agent."
    },
    "extension": {
      "type": "string",
      "example": "0020",
      "description": "Primary phone extension of the agent."
    },
    "esn": {
      "type": "string",
      "example": "0020",
      "description": "Routing prefix + extension of a agent."
    },
    "phoneNumber": {
      "type": "string",
      "example": "+1972998998",
      "description": "Primary phone number of the agent."
    }
  }
}