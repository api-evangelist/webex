{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Language",
  "title": "Language",
  "type": "object",
  "required": [
    "name",
    "code"
  ],
  "properties": {
    "name": {
      "type": "string",
      "example": "English",
      "description": "Language name."
    },
    "code": {
      "type": "string",
      "example": "en_us",
      "description": "Language code."
    }
  }
}