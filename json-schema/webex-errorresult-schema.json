{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ErrorResult",
  "title": "ErrorResult",
  "required": [
    "trackingId"
  ],
  "type": "object",
  "properties": {
    "error": {
      "$ref": "#/components/schemas/Error"
    },
    "trackingId": {
      "type": "string",
      "description": "Unique ID by which a request can be debugged, provided in request header or autogenerated. Please provide if opening a support case.",
      "example": "NOTIFS_9bcdc696-57fa-4e91-b5aa-57a66a347c23"
    }
  }
}