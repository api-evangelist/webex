    },
    "locationName": {
      "type": "string",
      "example": "Brampton",
      "description": "Name of the location. Included only when `target` is `LOCATION`."
    },
    "percentageComplete": {
      "type": "integer",
      "example": 10,
      "description": "Indicates the progress of the job."
    }
