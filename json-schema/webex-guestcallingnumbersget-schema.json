{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GuestCallingNumbersGet",
  "title": "GuestCallingNumbersGet",
  "type": "object",
  "required": [
    "phoneNumbers"
  ],
  "example": {
    "phoneNumbers": [
      {
        "phoneNumber": "+12065551212",
        "state": "ACTIVE",
        "isMainNumber": false
      },
      {
        "phoneNumber": "+12065551213",
        "state": "INACTIVE",
        "isMainNumber": true
      }
    ]
  },
  "properties": {
    "phoneNumbers": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/GuestCallingNumber"
      },
      "description": "List of phone numbers available for guest calling.",
      "example": [
        {
          "phoneNumber": "+12065551212",
          "state": "ACTIVE",
          "isMainNumber": false
        }
      ]
    }
  }
}