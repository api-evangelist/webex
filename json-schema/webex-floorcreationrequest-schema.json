{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/FloorCreationRequest",
  "title": "FloorCreationRequest",
  "type": "object",
  "required": [
    "floorNumber"
  ],
  "properties": {
    "floorNumber": {
      "type": "number",
      "example": -1,
      "description": "The floor number."
    },
    "displayName": {
      "type": "string",
      "example": "The basement",
      "description": "The floor display name."
    }
  }
}