{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GetScheduleObject",
  "title": "GetScheduleObject",
  "type": "object",
  "required": [
    "id",
    "name",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "example": "Y2lzY29zcGFyazovL3VzL1NDSEVEVUxFL1FWVlVUMEZVVkVWT1JFRk9WQzFDVlZOSlRrVlRVeTFJVDFWU1V3",
      "description": "A unique identifier for the schedule."
    },
    "name": {
      "type": "string",
      "example": "AUTOATTENDANT-BUSINESS-HOURS",
      "description": "Unique name for the schedule."
    },
    "type": {
      "type": "string",
      "enum": [
        "businessHours",
        "holidays"
      ],
      "description": "Type of the schedule.\n * `businessHours` - Business hours schedule type.\n * `holidays` - Holidays schedule type.\n"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/GetScheduleEventObject"
      },
      "description": "List of schedule events."
    }
  }
}