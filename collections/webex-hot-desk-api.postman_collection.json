                  "disabled": false,
                  "key": "orgId",
                  "value": "<string>",
                  "description": "List sessions in this organization. Only admin users of another organization (such as partners) may use this parameter."
                },
                {
                  "disabled": false,
                  "key": "personId",
                  "value": "<string>",
                  "description": "List sessions for this person."
                },
