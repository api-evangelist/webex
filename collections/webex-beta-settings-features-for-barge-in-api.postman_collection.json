          "name": "Get Barge-In Settings",
          "request": {
            "name": "Get Barge-In Settings",
            "description": {
              "content": "Retrieve Barge-In settings of the user.\n\nThe Barge-In feature enables you to use a Feature Access Code (FAC) to answer a call that was directed to another subscriber, or barge-in on the call if it was already answered. Barge-In can be used across locations.\n\nThis API requires a user auth token with a scope of `spark:telephony_config_read`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "telephony",
                "config",
                "people",
                "me",
                "settings",
                "bargeIn"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
