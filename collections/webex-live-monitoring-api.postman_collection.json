          "id": "88d1daf3-b4e1-4aff-b213-954ffa6132d2",
          "name": "Get Live Meeting metrics categorized by Country",
          "request": {
            "name": "Get Live Meeting metrics categorized by Country",
            "description": {
              "content": "Retrieve live meeting metrics categorized by country for a specific meeting site or for all meeting sites owned by the customer. \n\nTo retrieve live monitoring information, you must use an administrator token with the `analytics:read_all` [scope](/docs/integrations#scopes). The authenticated user must be a read-only or full administrator of the organization to which the meeting belongs and must not be an external administrator.\n\nTo use this endpoint, the org needs to be licensed for the Webex Pro Pack.\n\nA rate limit of one API call per minute applies to each customer organization",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "livemonitoring",
                "liveMeetingsByCountry"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"siteIds\": [\n    \"<integer>\",\n    \"<integer>\"\n  ],\n  \"siteUrl\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
