          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/v1/api/person/workspace-id/:workspaceId/aliases/:aliases",
            "params": [
              {
                "name": "workspaceId",
                "value": "63feryn344678998djs878",
                "type": "path",
                "description": "Workspace ID"
              },
              {
                "name": "aliases",
                "value": "johndoe@domain1.com,2771154",
                "type": "path",
                "description": "Aliases to search for. Multiple aliases should be separated by a comma. \n\n In case the alias(es) contain(s) non-uri-encodable characters, eg: '+', '>' etc, you can URL-encode the same and then pass it as parameter."
              },
              {
                "name": "sortBy",
                "value": "firstName",
                "type": "query",
                "description": "Sort By Field"
