          "info": {
            "name": "Add/Remove/Replace details of a Person",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/v1/api/person/workspace-id/:workspaceId/person-id/:personId",
            "params": [
              {
                "name": "workspaceId",
                "value": "63feryn344678998djs878",
                "type": "path",
                "description": "Workspace ID"
              },
              {
                "name": "personId",
