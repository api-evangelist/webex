              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\n      \"contactAttributes\": [\n        {\n          \"fieldName\": \"<string>\",\n          \"value\": \"<string>\"\n        },\n        {\n          \"fieldName\": \"<string>\",\n          \"value\": \"<string>\"\n        }\n      ]\n    },\n    {\n      \"contactAttributes\": [\n        {\n          \"fieldName\": \"<string>\",\n          \"value\": \"<string>\"\n        },\n        {\n          \"fieldName\": \"<string>\",\n          \"value\": \"<string>\"\n        }\n      ]\n    }\n  ]\n}",
