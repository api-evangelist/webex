        {
          "id": "ef52fbdb-8bcc-4c80-a7ab-8eac985bf9f7",
          "name": "Create contacts within a contact list",
          "request": {
            "name": "Create contacts within a contact list",
            "description": {
              "content": "Creates contacts within a contact list (only if that contact list was created using API method). If the contact record is invalid, it will be added as INVALID and reflected in the 'Processed' and 'Invalid' counts. This is an Asynchronous operation. The values within the 'contactAttributes' param should conform to datatypes of the contact attributes as specified in the 'Field mapping' associated with the campaign.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "campaign-management",
                "campaigns",
                ":campaignId",
                "contact-list",
                ":contactListId",
                "contacts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "campaignId",
                  "description": "(Required) Campaign ID to which the contact list belongs."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "contactListId",
                  "description": "(Required) Contact List ID (as a number string)."
                }
