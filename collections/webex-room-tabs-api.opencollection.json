{
  "opencollection": "1.0.0",
  "info": {
    "name": "Webex Admin Address Book Room Tabs API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Room Tabs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Room Tabs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/room/tabs",
            "params": [
              {
                "name": "roomId",
                "value": "Y2lzY29zcGFyazovL3VzL1JPT00vYmJjZWIxYWQtNDNmMS0zYjU4LTkxNDctZjE0YmIwYzRkMTU0",
                "type": "query",
                "description": "ID of the room for which to list room tabs."
              }
            ]
          },
          "docs": "Lists all Room Tabs of a room specified by the `roomId` query parameter."
        },
        {
          "info": {
            "name": "Create a Room Tab",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/room/tabs",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add a tab with a specified URL to a room."
        },
        {
          "info": {
            "name": "Get Room Tab Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/room/tabs/:id",
            "params": [
              {
                "name": "id",
                "value": "Y2lzY29zcGFyazovL3VzL01FTUJFUlNISVAvMGQwYzkxYjYtY2U2MC00NzI1LWI2ZDAtMzQ1NWQ1ZDExZWYzOmNkZTFkZDQwLTJmMGQtMTFlNS1iYTljLTdiNjU1NmQyMjA3Yg",
                "type": "path",
                "description": "The unique identifier for the Room Tab."
              }
            ]
          },
          "docs": "Get details for a Room Tab with the specified room tab ID."
        },
        {
          "info": {
            "name": "Update a Room Tab",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/room/tabs/:id",
            "params": [
              {
                "name": "id",
                "value": "Y2lzY29zcGFyazovL3VzL01FTUJFUlNISVAvMGQwYzkxYjYtY2U2MC00NzI1LWI2ZDAtMzQ1NWQ1ZDExZWYzOmNkZTFkZDQwLTJmMGQtMTFlNS1iYTljLTdiNjU1NmQyMjA3Yg",
                "type": "path",
                "description": "The unique identifier for the Room Tab."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the content URL of the specified Room Tab ID."
        },
        {
          "info": {
            "name": "Delete a Room Tab",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/room/tabs/:id",
            "params": [
              {
                "name": "id",
                "value": "Y2lzY29zcGFyazovL3VzL01FTUJFUlNISVAvMGQwYzkxYjYtY2U2MC00NzI1LWI2ZDAtMzQ1NWQ1ZDExZWYzOmNkZTFkZDQwLTJmMGQtMTFlNS1iYTljLTdiNjU1NmQyMjA3Yg",
                "type": "path",
                "description": "The unique identifier for the Room Tab to delete."
              }
            ]
          },
          "docs": "Deletes a Room Tab with the specified ID."
        }
      ]
    }
  ],
  "bundled": true
}