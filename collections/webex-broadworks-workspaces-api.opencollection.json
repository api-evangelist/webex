                "name": "workspaceId",
                "value": "Y2lzY29zcGFyazovL3VzL1BMQUNFL2RkMjJlZGZlLTlmZWYtNDdmOS05ODFkLWYxYjA3MWFmMDcwYw",
                "type": "path",
                "description": "A unique Cisco identifier for the workspace."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update certain details of a provisioned BroadWorks workspace on Cisco Webex."
        },
        {
          "info": {
            "name": "Remove a BroadWorks Workspace",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/broadworks/workspaces/:workspaceId",
            "params": [
              {
                "name": "workspaceId",
                "value": "Y2lzY29zcGFyazovL3VzL1BMQUNFL2RkMjJlZGZlLTlmZWYtNDdmOS05ODFkLWYxYjA3MWFmMDcwYw",
                "type": "path",
