            "method": "GET",
            "url": "{{baseUrl}}/admin/v1/api/workspace/workspace-id/:workspaceId",
            "params": [
              {
                "name": "workspaceId",
                "value": "6377dafe02e7cc19b03a71b7",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://webexapis.com/v1/authorize",
              "accessTokenUrl": "https://webexapis.com/v1/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get workspace details. Use the cjp scope if you have a contact center license; otherwise, use the cjds scope. It requires the appropriate cjds:admin_org_read or cjds:admin_org_write scopes or cjp:config_read or cjp:config_write scopes"
