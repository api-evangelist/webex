          "name": "List Security Audit Events",
          "request": {
            "name": "List Security Audit Events",
            "description": {
              "content": "List Security Audit Events. This API currently returns user sign-in and sign-out data.\nTo call this API the `audit:events_read` scope must be selected for the Integration or Service App and authorized by a Full Admin.\n\nSeveral query parameters are available to filter the response.\n\nLong result sets will be split into multiple [pages](/docs/basics#pagination)\n\n**NOTE**: A maximum of one year of audit events can be returned per request.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "admin",
                "securityAudit",
                "events"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "orgId",
                  "value": "<string>",
                  "description": "(Required) List events in this organization, by ID."
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<string>",
                  "description": "(Required) List events which occurred after a specific date and time."
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<string>",
                  "description": "(Required) List events which occurred before a specific date and time."
                },
                {
                  "disabled": false,
                  "key": "actorId",
                  "value": "<string>",
                  "description": "List events performed by this person, by ID."
                },
                {
                  "disabled": false,
                  "key": "max",
                  "value": "100",
                  "description": "Limit the maximum number of events in the response. The maximum value is `1000`."
                },
                {
                  "disabled": false,
                  "key": "eventCategories",
                  "value": "<string>",
                  "description": "List events, by event categories."
                },
                {
                  "disabled": false,
                  "key": "eventCategories",
                  "value": "<string>",
                  "description": "List events, by event categories."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
