                                        "config",
                                        "people",
                                        "me",
                                        "settings",
                                        "contactCenterExtensions"
                                      ]
                                    }
                                  },
                                  "status": "OK",
                                  "code": 200,
                                  "_postman_previewlanguage": "json",
                                  "header": [
                                    {
                                      "key": "Content-Type",
                                      "value": "application/json"
                                    }
                                  ],
                                  "cookie": [],
                                  "responseTime": null,
                                  "body": "{\n  \"ccExtensions\": [\n    {\n      \"directNumber\": \"<string>\",\n      \"extension\": \"<string>\",\n      \"type\": \"PRIMARY\",\n      \"lineOwnerType\": \"PEOPLE\",\n      \"lineOwnerId\": \"<string>\",\n      \"preferredAnsweringEndPointId\": \"<string>\",\n      \"endpoints\": [\n        {\n          \"id\": \"<string>\",\n          \"type\": \"HOTDESKING_GUEST\"\n        },\n        {\n          \"id\": \"<string>\",\n          \"type\": \"APPLICATION\"\n        }\n      ]\n    },\n    {\n      \"directNumber\": \"<string>\",\n      \"extension\": \"<string>\",\n      \"type\": \"PRIMARY\",\n      \"lineOwnerType\": \"PLACE\",\n      \"lineOwnerId\": \"<string>\",\n      \"preferredAnsweringEndPointId\": \"<string>\",\n      \"endpoints\": [\n        {\n          \"id\": \"<string>\",\n          \"type\": \"HOTDESKING_GUEST\"\n        },\n        {\n          \"id\": \"<string>\",\n          \"type\": \"APPLICATION\"\n        }\n      ]\n    }\n  ],\n  \"endpoints\": [\n    {\n      \"id\": \"<string>\",\n      \"type\": \"HOTDESKING_GUEST\",\n      \"name\": \"<string>\",\n      \"status\": \"CONNECTED\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"type\": \"HOTDESKING_GUEST\",\n      \"name\": \"<string>\",\n      \"status\": \"NOT_CONNECTED\"\n    }\n  ]\n}",
